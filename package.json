{
  "name": "@inverge/nexus",
  "version": "1.5.0",
  "description": "Nexus \u2014 one JavaScript/TypeScript SDK for all Inverge Nexus services (analytics, logs, errors, feature flags, remote config, realtime, links, surveys). Works in every browser framework and in Node \u2014 plus Telescope request-journey tracing for every Node framework.",
  "author": "Inverge <info@inverge.net>",
  "license": "MIT",
  "homepage": "https://nexus.inverge.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Inverge-team/nexus-js.git"
  },
  "keywords": [
    "nexus",
    "inverge",
    "analytics",
    "feature-flags",
    "remote-config",
    "realtime",
    "logging",
    "error-monitoring",
    "react",
    "node"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./telescope": {
      "types": "./dist/telescope/index.d.ts",
      "import": "./dist/telescope/index.js",
      "require": "./dist/telescope/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=17",
    "rrweb": ">=2",
    "socket.io-client": ">=4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "socket.io-client": {
      "optional": true
    },
    "rrweb": {
      "optional": "true"
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.0.0",
    "jsdom": "^29.1.1",
    "react": "^18.0.0",
    "rrweb": "^2.0.0-alpha.18",
    "socket.io-client": "^4.7.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  }
}
